<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container my-5 flex-grow-1">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card bg-dark text-light border-secondary p-4 shadow">
                <h3 class="fw-bold mb-3 text-center">Entrar no Poetweet</h3>
                
                <!-- Exibe mensagem se houver erro de senha ou e-mail -->
                <% if (typeof erro !== 'undefined' && erro) { %>
                    <div class="alert alert-danger"><%= erro %></div>
                <% } %>

                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label">E-mail</label>
                        <input type="email" name="email" class="form-control bg-black text-light border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <input type="password" name="senha" class="form-control bg-black text-light border-secondary" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Entrar</button>
                </form>

                <hr class="border-secondary my-4">

                <p class="text-center text-secondary mb-0">
                    Ainda não tem conta? <a href="/cadastro" class="text-primary text-decoration-none">Cadastre-se</a>
                </p>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>