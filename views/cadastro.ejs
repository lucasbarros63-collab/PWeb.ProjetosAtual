<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container my-5 flex-grow-1">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card bg-dark text-light border-secondary p-4 shadow">
                <h3 class="fw-bold mb-3 text-center">Criar Conta</h3>
                <% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
                
                <form action="/cadastro" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Seu Nome Completo</label>
                        <input type="text" name="nome" class="form-control bg-black text-light border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">E-mail</label>
                        <input type="email" name="email" class="form-control bg-black text-light border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <input type="password" name="senha" class="form-control bg-black text-light border-secondary" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Cadastrar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>